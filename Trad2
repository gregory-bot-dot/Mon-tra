<script>
const $ = id => document.getElementById(id);
const ASSETS = {
  auto:{name:'Auto',dec:2,unit:''},
  crypto:{name:'Crypto',dec:2,unit:'',session:'24/7'},
  forex:{name:'Forex',dec:4,unit:'',session:'Lun-Ven'},
  stocks:{name:'Action',dec:2,unit:'$',session:'Heures marché'},
  indices:{name:'Indice',dec:1,unit:'pts',session:'Heures marché'},
  commodities:{name:'Mat. prem.',dec:2,unit:'$',session:'Sessions mixtes'}
};
const TV_GREEN = [[38,166,154],[8,153,129],[76,175,80],[0,150,136]];
const TV_RED   = [[239,83,80],[242,54,69],[244,67,54],[255,82,82]];

const S = {
  cv:$('cv'), ov:$('overlay'), ctx:null, octx:null,
  loaded:false, imageDataURL:null,
  candles:[], swings:[], analysis:null, smc:null, setups:null, forecast:null,
  priceCal:null, mouse:null, zoom:1, aiText:null,
  layout:null,
  calibMode:false, calibPoint:null, calibPoints:[]
};
S.ctx = S.cv.getContext('2d', {willReadFrequently:true});
S.octx = S.ov.getContext('2d');

function profile(){ return ASSETS[$('assetType').value] || ASSETS.auto; }
function inferDecimals(v){
  if(!isFinite(v)) return 2;
  const a = Math.abs(v);
  if(a >= 1000) return 2;
  if(a >= 1) return a >= 100 ? 2 : 4;
  return 5;
}
function yToPrice(y){
  const c = S.priceCal;
  if(!c) return null;
  if(c.mode === 'click' || c.mode === 'manual'){
    const p1 = c.p1, p2 = c.p2;
    if(Math.abs(p2.y - p1.y) < 0.5) return p1.price;
    return p1.price + (y - p1.y) * (p2.price - p1.price) / (p2.y - p1.y);
  }
  return null;
}
function priceToY(p){
  const c = S.priceCal;
  if(!c) return null;
  const p1 = c.p1, p2 = c.p2;
  if(Math.abs(p2.price - p1.price) < 1e-9) return p1.y;
  return p1.y + (p - p1.price) * (p2.y - p1.y) / (p2.price - p1.price);
}
function fmtPrice(p, dec){
  if(p === null || !isFinite(p)) return '—';
  const d = dec !== undefined ? dec : (S.priceCal?.dec ?? profile().dec);
  const u = profile().unit;
  return p.toLocaleString('fr-FR', {minimumFractionDigits:d, maximumFractionDigits:d}) + (u ? ' '+u : '');
}
function fmtLevel(y){
  const p = yToPrice(y);
  if(p !== null) return fmtPrice(p);
  const a = S.analysis;
  if(!a) return '—';
  const rel = (a.maxY - y) / (a.maxY - a.minY || 1);
  return (rel*100).toFixed(1) + '%';
}
function priceOrPct(y){
  const p = yToPrice(y);
  if(p !== null) return fmtPrice(p);
  const a = S.analysis;
  if(!a) return '—';
  const rel = (a.maxY - y) / (a.maxY - a.minY || 1);
  return 'h ' + (rel*100).toFixed(1) + '%';
}

/* ============ CHARGEMENT ============ */
async function handleFile(file){
  if(!file || !file.type.startsWith('image/')) return;
  setStatus('Chargement…', true);
  try{
    const url = await new Promise((res, rej) => {
      const fr = new FileReader();
      fr.onload = () => res(fr.result);
      fr.onerror = rej;
      fr.readAsDataURL(file);
    });
    const img = await new Promise((res, rej) => {
      const i = new Image();
      i.onload = () => res(i);
      i.onerror = rej;
      i.src = url;
    });
    const MAX = 1600;
    const k = Math.min(1, MAX/Math.max(img.naturalWidth, img.naturalHeight));
    const w = Math.round(img.naturalWidth*k), h = Math.round(img.naturalHeight*k);
    S.cv.width = w; S.cv.height = h;
    S.ov.width = w; S.ov.height = h;
    S.ctx.drawImage(img, 0, 0, w, h);
    S.imageDataURL = S.cv.toDataURL('image/jpeg', 0.92);

    S.loaded = true; S.mouse = null; S.priceCal = null; S.aiText = null;
    S.calibMode = false; S.calibPoints = [];

    $('emptyChart').style.display = 'none';
    $('canvasInner').style.display = 'block';
    $('btnAI').disabled = false;
    $('btnPrompt').disabled = false;
    $('btnClear').disabled = false;
    $('btnOCR').disabled = false;
    $('btnClick').disabled = false;
    $('btnExport').disabled = false;
    $('calStatus').textContent = 'Sans calibration : % de hauteur. Utilisez "Calibrer au clic" pour des prix exacts.';
    $('calibSteps').classList.add('hidden');

    runAnalysis();
  }catch(err){ console.error(err); setStatus('Erreur'); }
}

/* ============ DÉTECTION LAYOUT ============ */
function detectTheme(data, W, H){
  const samples = [[Math.floor(W*.05),Math.floor(H*.05)],[Math.floor(W*.95),Math.floor(H*.05)],[Math.floor(W*.05),Math.floor(H*.95)],[Math.floor(W*.95),Math.floor(H*.95)],[Math.floor(W*.5),Math.floor(H*.5)]];
  let lum = 0;
  for(const [x,y] of samples){ const i = (y*W+x)*4; lum += .299*data[i] + .587*data[i+1] + .114*data[i+2]; }
  return lum/samples.length < 128 ? 'dark' : 'light';
}
function colorDist(a, b){ return Math.abs(a[0]-b[0])+Math.abs(a[1]-b[1])+Math.abs(a[2]-b[2]); }
function classifyPixel(r, g, b, a){
  if(a < 20) return 0;
  const p = [r,g,b];
  for(const c of TV_GREEN) if(colorDist(p, c) < 85) return 1;
  for(const c of TV_RED)   if(colorDist(p, c) < 85) return 2;
  const mx = Math.max(r,g,b), mn = Math.min(r,g,b), sat = mx-mn;
  if(sat < 50) return 0;
  if(g === mx && g-r > 30 && g-b > 15) return 1;
  if(r === mx && r-g > 30 && r-b > 15) return 2;
  return 0;
}
function detectVolumeSplit(rowActivity, W, H){
  const startY = Math.floor(H * .55);
  for(let y = startY; y < H * .95; y++){
    if(rowActivity[y] < W * .003){
      let below = 0;
      for(let y2 = y+1; y2 < H*.98; y2++) if(rowActivity[y2] > W*.008) below++;
      if(below > 6) return y;
    }
  }
  return H;
}
function detectLayout(){
  const W = S.cv.width, H = S.cv.height;
  const data = S.ctx.getImageData(0, 0, W, H).data;
  const theme = detectTheme(data, W, H);
  const cls = new Uint8Array(W * H);
  for(let p = 0, i = 0; i < data.length; i += 4, p++){
    cls[p] = classifyPixel(data[i], data[i+1], data[i+2], data[i+3]);
  }
  const rowAct = new Int32Array(H), colAct = new Int32Array(W);
  for(let y = 0; y < H; y++){
    let rc = 0;
    for(let x = 0; x < W; x++){ if(cls[y*W+x]){ rc++; colAct[x]++; } }
    rowAct[y] = rc;
  }
  const volumeSplit = detectVolumeSplit(rowAct, W, H);
  const hasVolume = volumeSplit < H * .98;
  let chartLeft = W, chartRight = 0, chartTop = H, chartBottom = 0;
  for(let y = 0; y < volumeSplit; y++){
    for(let x = 0; x < W; x++){
      if(cls[y*W+x]){
        if(x < chartLeft) chartLeft = x;
        if(x > chartRight) chartRight = x;
        if(y < chartTop) chartTop = y;
        if(y > chartBottom) chartBottom = y;
      }
    }
  }
  return { theme, cls, colAct, volumeSplit, hasVolume, chartLeft, chartRight, chartTop, chartBottom, rightMargin:W-chartRight, leftMargin:chartLeft, W, H };
}

/* ============ DÉTECTION BOUGIES ============ */
function detectCandles(layout){
  const { cls, colAct, chartLeft, chartRight, volumeSplit, W, H } = layout;
  const active = x => colAct[x] >= 2;
  const candles = [];
  let x = Math.max(0, chartLeft - 2);
  const xEnd = Math.min(W, chartRight + 3);
  while(x < xEnd){
    if(!active(x)){ x++; continue; }
    const x1 = x;
    while(x < xEnd && active(x)) x++;
    const x2 = x - 1;
    const width = x2 - x1 + 1;
    if(width > 60) continue;
    let yTop = H, yBot = -1;
    for(let yy = 0; yy < volumeSplit; yy++){
      for(let xx = x1; xx <= x2; xx++){
        if(cls[yy*W+xx]){ if(yy<yTop) yTop=yy; if(yy>yBot) yBot=yy; break; }
      }
    }
    if(yBot < 0 || yBot - yTop < 2) continue;
    const bodyTh = Math.max(2, Math.round(width*.5));
    let bodyTop = -1, bodyBot = -1;
    for(let yy = yTop; yy <= yBot; yy++){
      let cnt = 0;
      for(let xx = x1; xx <= x2; xx++) if(cls[yy*W+xx]) cnt++;
      if(cnt >= bodyTh){ if(bodyTop<0) bodyTop=yy; bodyBot=yy; }
    }
    if(bodyTop < 0){ bodyTop = yTop; bodyBot = yBot; }
    let gA = 0, rA = 0;
    for(let yy = yTop; yy <= yBot; yy++){
      for(let xx = x1; xx <= x2; xx++){
        const c = cls[yy*W+xx];
        if(c === 1) gA++; else if(c === 2) rA++;
      }
    }
    candles.push({
      x:(x1+x2)/2, x1, x2, width,
      high:yTop, low:yBot, bodyTop, bodyBot,
      mid:(yTop+yBot)/2,
      bull:gA >= rA,
      bodySize:Math.abs(bodyBot - bodyTop),
      range:yBot - yTop
    });
  }
  return candles;
}

/* ============ SWINGS ============ */
function detectSwings(candles){
  if(candles.length < 5) return [];
  const win = Math.max(2, Math.round(candles.length/15));
  const swings = [];
  for(let i = win; i < candles.length - win; i++){
    let isH = true, isL = true;
    const ci = candles[i];
    for(let j = i-win; j <= i+win; j++){
      if(j === i) continue;
      if(candles[j].high < ci.high) isH = false;
      if(candles[j].low > ci.low) isL = false;
    }
    if(isH) swings.push({i, x:ci.x, y:ci.high, type:'H', candle:ci});
    else if(isL) swings.push({i, x:ci.x, y:ci.low, type:'L', candle:ci});
  }
  return swings;
}

/* ============ STRUCTURE HH/HL/LH/LL + BOS/CHoCH ============ */
function classifySwings(swings){
  const Hs = swings.filter(s => s.type === 'H');
  const Ls = swings.filter(s => s.type === 'L');
  const labeled = [];
  for(let k = 0; k < Hs.length; k++){
    const prev = Hs[k-1];
    labeled.push({...Hs[k], label: !prev ? 'H' : (Hs[k].y < prev.y ? 'HH' : 'LH')});
  }
  for(let k = 0; k < Ls.length; k++){
    const prev = Ls[k-1];
    labeled.push({...Ls[k], label: !prev ? 'L' : (Ls[k].y > prev.y ? 'LL' : 'HL')});
  }
  return labeled.sort((a,b) => a.i - b.i);
}

function detectBOSCHoCH(candles, swings){
  const Hs = swings.filter(s => s.type === 'H');
  const Ls = swings.filter(s => s.type === 'L');
  const events = [];
  for(let i = 2; i < candles.length; i++){
    const c = candles[i];
    const prevH = Hs.filter(s => s.i < i-1).slice(-2);
    const prevL = Ls.filter(s => s.i < i-1).slice(-2);

    if(prevH.length >= 1){
      const lastH = prevH[prevH.length - 1];
      if(c.bodyTop < lastH.y - 2 && c.bodyBot < lastH.y - 2){
        const isCHoCH = prevH.length >= 2 && prevH[prevH.length-1].y > prevH[prevH.length-2].y;
        events.push({type: isCHoCH ? 'CHoCH' : 'BOS', dir: 'bullish', i, levelY: lastH.y, candleX: c.x, bodyY: c.bodyTop});
      }
    }
    if(prevL.length >= 1){
      const lastL = prevL[prevL.length - 1];
      if(c.bodyBot > lastL.y + 2 && c.bodyTop > lastL.y + 2){
        const isCHoCH = prevL.length >= 2 && prevL[prevL.length-1].y < prevL[prevL.length-2].y;
        events.push({type: isCHoCH ? 'CHoCH' : 'BOS', dir: 'bearish', i, levelY: lastL.y, candleX: c.x, bodyY: c.bodyBot});
      }
    }
  }
  const seen = new Set();
  return events.filter(e => {
    const key = e.i + '-' + e.type + '-' + e.dir;
    if(seen.has(key)) return false;
    seen.add(key);
    return true;
  }).slice(-6);
}

/* ============ ORDER BLOCKS ============ */
function detectOrderBlocks(candles){
  const avgBody = candles.reduce((s, c) => s + c.bodySize, 0) / candles.length;
  const obs = [];
  for(let i = 2; i < candles.length - 1; i++){
    const c = candles[i];
    if(c.bodySize < avgBody * 1.6) continue;
    if(c.bull){
      // Impulsion haussière → chercher dernière bougie rouge avant
      for(let j = i - 1; j >= Math.max(0, i - 8); j--){
        if(!candles[j].bull){
          obs.push({
            type:'bullish', i:j,
            high:candles[j].high, low:candles[j].low,
            bodyTop:candles[j].bodyTop, bodyBot:candles[j].bodyBot,
            x:candles[j].x
          });
          break;
        }
      }
    } else {
      for(let j = i - 1; j >= Math.max(0, i - 8); j--){
        if(candles[j].bull){
          obs.push({
            type:'bearish', i:j,
            high:candles[j].high, low:candles[j].low,
            bodyTop:candles[j].bodyTop, bodyBot:candles[j].bodyBot,
            x:candles[j].x
          });
          break;
        }
      }
    }
  }
  // Dédoublonnage par index
  const seen = new Set();
  const unique = obs.filter(o => { if(seen.has(o.i)) return false; seen.add(o.i); return true; });
  // Mitigation
  for(const ob of unique){
    ob.mitigated = false;
    ob.touches = 0;
    for(let k = ob.i + 2; k < candles.length; k++){
      const c = candles[k];
      const overlaps = c.low <= ob.high && c.high >= ob.low;
      if(overlaps){
        ob.touches++;
        if(ob.type === 'bullish' && c.low <= ob.high) ob.mitigated = true;
        if(ob.type === 'bearish' && c.high >= ob.low) ob.mitigated = true;
      }
    }
  }
  return {
    bullish: unique.filter(o => o.type === 'bullish').slice(-4),
    bearish: unique.filter(o => o.type === 'bearish').slice(-4)
  };
}

/* ============ FAIR VALUE GAPS ============ */
function detectFVGs(candles){
  const fvgs = [];
  for(let i = 1; i < candles.length - 1; i++){
    const prev = candles[i-1], next = candles[i+1], mid = candles[i];
    // Bullish FVG : next.low > prev.high (gap haussier)
    if(next.low > prev.high + 2 && mid.bull){
      fvgs.push({
        type:'bullish', i,
        yTop:prev.high, yBot:next.low,
        top:prev.high, bot:next.low,
        x:(prev.x + next.x)/2, size:next.low - prev.high
      });
    }
    // Bearish FVG : next.high < prev.low
    if(next.high < prev.low - 2 && !mid.bull){
      fvgs.push({
        type:'bearish', i,
        yTop:next.high, yBot:prev.low,
        top:next.high, bot:prev.low,
        x:(prev.x + next.x)/2, size:prev.low - next.high
      });
    }
  }
  // Fill status
  for(const fvg of fvgs){
    fvg.filled = false;
    fvg.fillPct = 0;
    for(let k = fvg.i + 2; k < candles.length; k++){
      const c = candles[k];
      if(fvg.type === 'bullish'){
        if(c.low >= fvg.yBot){ fvg.filled = true; fvg.fillPct = 100; }
        else if(c.low > fvg.yTop){
          const fill = (c.low - fvg.yTop) / (fvg.yBot - fvg.yTop);
          fvg.fillPct = Math.max(fvg.fillPct, Math.round(fill*100));
        }
      } else {
        if(c.high <= fvg.yTop){ fvg.filled = true; fvg.fillPct = 100; }
        else if(c.high < fvg.yBot){
          const fill = (fvg.yBot - c.high) / (fvg.yBot - fvg.yTop);
          fvg.fillPct = Math.max(fvg.fillPct, Math.round(fill*100));
        }
      }
    }
  }
  return fvgs.filter(f => !f.filled && f.size > 3).slice(-6);
}

/* ============ LIQUIDITY SWEEPS ============ */
function detectLiquiditySweeps(candles, swings){
  const sweeps = [];
  for(let i = 2; i < candles.length; i++){
    const c = candles[i];
    for(const sw of swings){
      if(sw.i >= i - 1) continue;
      if(i - sw.i > 40) continue;
      if(sw.type === 'H'){
        // Mèche au-dessus du swing high mais close en-dessous
        if(c.high < sw.y && c.bodyTop >= sw.y - 1 && c.bodyBot > sw.y){
          sweeps.push({type:'bearish', i, levelY:sw.y, levelX:sw.x, sweepX:c.x, label:'Sweep sommet'});
        }
      } else {
        if(c.low > sw.y && c.bodyBot <= sw.y + 1 && c.bodyTop < sw.y){
          sweeps.push({type:'bullish', i, levelY:sw.y, levelX:sw.x, sweepX:c.x, label:'Sweep creux'});
        }
      }
    }
  }
  // Dédup
  const seen = new Set();
  return sweeps.filter(s => {
    const k = s.i + '-' + s.type + '-' + Math.round(s.levelY);
    if(seen.has(k)) return false;
    seen.add(k);
    return true;
  }).slice(-5);
}

/* ============ EQUAL HIGHS/LOWS ============ */
function detectEqualLevels(swings, tolerance){
  const groups = [];
  for(const sw of swings){
    let found = false;
    for(const g of groups){
      if(g.type === sw.type && Math.abs(g.y - sw.y) < tolerance){
        g.ys.push(sw.y); g.count++;
        g.y = g.ys.reduce((s, v) => s+v, 0)/g.ys.length;
        g.xs.push(sw.x);
        found = true; break;
      }
    }
    if(!found) groups.push({type:sw.type, y:sw.y, ys:[sw.y], count:1, xs:[sw.x]});
  }
  return groups.filter(g => g.count >= 2).sort((a, b) => b.count - a.count).slice(0, 4);
}

/* ============ PREMIUM / DISCOUNT ============ */
function detectPremiumDiscount(candles, swings){
  const lastH = swings.filter(s => s.type === 'H').slice(-1)[0];
  const lastL = swings.filter(s => s.type === 'L').slice(-1)[0];
  if(!lastH || !lastL) return null;
  // Prendre le range le plus récent (peu importe l'ordre)
  let hi = Math.min(lastH.y, lastL.y);
  let lo = Math.max(lastH.y, lastL.y);
  const mid = (hi + lo) / 2;
  const currentY = candles[candles.length - 1].mid;
  // Position dans le range : 0 = top, 1 = bottom
  const pos = (currentY - hi) / (lo - hi);
  let zone;
  if(pos < 0.25) zone = 'Premium extrême';
  else if(pos < 0.5) zone = 'Premium';
  else if(pos < 0.75) zone = 'Discount';
  else zone = 'Discount extrême';
  // Fibs
  const range = lo - hi;
  const fibs = [
    {level:0, y:hi},
    {level:0.236, y:hi + range*0.236},
    {level:0.5, y:hi + range*0.5},
    {level:0.618, y:hi + range*0.618},
    {level:0.786, y:hi + range*0.786},
    {level:1, y:lo}
  ];
  return { hi, lo, mid, pos, zone, fibs, currentY };
}

/* ============ ANALYSE PRINCIPALE ============ */
function runAnalysis(){
  if(!S.loaded) return;
  setStatus('Analyse SMC…', true);
  try{
    S.layout = detectLayout();
    S.candles = detectCandles(S.layout);
    if(S.candles.length < 6){
      setStatus('Trop peu de bougies');
      $('tabSignal').innerHTML = '<div class="warnbox">Pas assez de bougies détectées. Essayez un screenshot TradingView plus propre (bouton "Screenshot natif" de TradingView de préférence).</div>';
      return;
    }

    S.swings = detectSwings(S.candles);
    S.swingsLabeled = classifySwings(S.swings);

    const structure = detectStructure(S.swingsLabeled);
    S.analysis = computeRegressionAnalysis(S.candles, structure);
    S.analysis.swings = S.swings;

    S.smc = {
      obs: detectOrderBlocks(S.candles),
      fvgs: detectFVGs(S.candles),
      sweeps: detectLiquiditySweeps(S.candles, S.swings),
      equalLevels: detectEqualLevels(S.swings, Math.max(4, S.cv.height/80)),
      bosCHoCH: detectBOSCHoCH(S.candles, S.swings),
      pd: detectPremiumDiscount(S.candles, S.swings),
      labeledSwings: S.swingsLabeled,
      structure
    };

    S.setups = computeSetups(S.candles, S.analysis, S.smc);
    S.forecast = computeForecast(S.candles, S.analysis, S.smc);

    renderAll();
    drawOverlay();
    setStatus(`${S.candles.length} bougies · confiance ${S.analysis.confidence}%`);
  }catch(err){
    console.error(err);
    setStatus('Erreur');
  }
}

function detectStructure(labeledSwings){
  const Hs = labeledSwings.filter(s => s.type === 'H').slice(-3);
  const Ls = labeledSwings.filter(s => s.type === 'L').slice(-3);
  if(Hs.length < 2 || Ls.length < 2) return {name:'Indéterminée', strength:0.3, bias:'flat'};
  const lastH = Hs[Hs.length-1], prevH = Hs[Hs.length-2];
  const lastL = Ls[Ls.length-1], prevL = Ls[Ls.length-2];
  const hUp = lastH.y < prevH.y;
  const lUp = lastL.y < prevL.y;
  if(hUp && lUp) return {name:'Haussier (HH + HL)', strength:0.9, bias:'up'};
  if(!hUp && !lUp) return {name:'Baissier (LH + LL)', strength:0.9, bias:'down'};
  return {name:'Range / transition', strength:0.4, bias:'flat'};
}

function computeRegressionAnalysis(candles, structure){
  const H = S.cv.height;
  const xs = candles.map(c => c.x);
  const ys = candles.map(c => c.mid);
  const n = xs.length;
  let sx=0, sy=0, sxx=0, sxy=0;
  for(let i = 0; i < n; i++){ sx+=xs[i]; sy+=ys[i]; sxx+=xs[i]*xs[i]; sxy+=xs[i]*ys[i]; }
  const slope = (n*sxy - sx*sy) / (n*sxx - sx*sx || 1);
  const intercept = (sy - slope*sx) / n;
  let ssTot=0, ssRes=0;
  const meanY = sy/n;
  for(let i = 0; i < n; i++){
    const pred = intercept + slope*xs[i];
    ssTot += (ys[i]-meanY)**2;
    ssRes += (ys[i]-pred)**2;
  }
  const r2 = ssTot > 0 ? Math.max(0, 1 - ssRes/ssTot) : 0;
  const slopeNorm = -slope;
  const trendDir = slopeNorm > .002 ? 'up' : slopeNorm < -.002 ? 'down' : 'flat';
  const avgRange = candles.reduce((s, c) => s + c.range, 0) / candles.length;
  const volatilityPct = (avgRange/H)*100;
  const recent = candles.slice(-14);
  const rsi = Math.round((recent.filter(c => c.bull).length / recent.length) * 100);
  const confidence = Math.min(95, Math.round(r2*40 + Math.min(30, candles.length/3) + (structure.strength||0)*25));
  const minY = Math.min(...candles.map(c => c.high));
  const maxY = Math.max(...candles.map(c => c.low));
  return {slope, intercept, r2, slopeNorm, trendDir, avgRange, volatilityPct, rsi, confidence, width:S.cv.width, height:H, minY, maxY, lastCandle:candles[candles.length-1], candleCount:candles.length};
}

/* ============ CALCUL DES SETUPS (SMC) ============ */

function confluenceScore(bullish){
  let score = 0;
  const tags = [];
  const smc = S.smc;
  const trend = S.analysis.structure.bias;

  if((bullish && trend === 'up') || (!bullish && trend === 'down')){
    score += 2; tags.push({text:'Aligné tendance', on:true});
  } else if(trend !== 'flat'){
    score -= 1; tags.push({text:'Contre tendance', on:false});
  }

  // OB aligné
  const obs = bullish ? smc.obs.bullish : smc.obs.bearish;
  const recentOB = obs.filter(o => !o.mitigated).slice(-1)[0];
  if(recentOB){ score += 2; tags.push({text:'OB non mitigé', on:true}); }

  // FVG
  const fvgAligned = smc.fvgs.find(f => f.type === (bullish ? 'bullish' : 'bearish'));
  if(fvgAligned){ score += 1; tags.push({text:'FVG ouvert', on:true}); }

  // Sweep
  const sweep = smc.sweeps.filter(s => s.type === (bullish ? 'bullish' : 'bearish')).slice(-1)[0];
  if(sweep){ score += 2; tags.push({text:'Sweep liquidité', on:true}); }

  // BOS/CHoCH
  const bosDir = smc.bosCHoCH.filter(e => e.dir === (bullish ? 'bullish' : 'bearish')).slice(-1)[0];
  if(bosDir){
    if(bosDir.type === 'CHoCH'){ score += 3; tags.push({text:'CHoCH', on:true}); }
    else { score += 1.5; tags.push({text:'BOS', on:true}); }
  }

  // Premium/Discount
  if(smc.pd){
    const isGoodZone = (bullish && smc.pd.pos > 0.5) || (!bullish && smc.pd.pos < 0.5);
    if(isGoodZone){ score += 1; tags.push({text: bullish ? 'Discount' : 'Premium', on:true}); }
  }

  return { score, tags };
}

function computeSetups(candles, analysis, smc){
  const last = candles[candles.length-1];
  const currentY = last.mid;
  const currentPrice = yToPrice(currentY);
  const calibrated = currentPrice !== null;
  const prof = profile();

  // Setup ACHAT
  const bullOB = smc.obs.bullish.filter(o => !o.mitigated && o.high > currentY).slice(-1)[0]
             || smc.obs.bullish.filter(o => o.high > currentY).slice(-1)[0]
             || smc.obs.bullish.slice(-1)[0];
  const bullFVG = smc.fvgs.filter(f => f.type === 'bullish' && f.yTop > currentY).slice(-1)[0];
  const bullSweep = smc.sweeps.filter(s => s.type === 'bullish').slice(-1)[0];

  let buyEntryY = null, buySLY = null, buyTP1Y = null, buyTP2Y = null;
  if(bullOB){
    buyEntryY = bullOB.high;
    buySLY = bullOB.low + 2;
  } else if(bullFVG){
    buyEntryY = bullFVG.yTop;
    buySLY = bullFVG.yBot + 2;
  } else if(bullSweep){
    buyEntryY = bullSweep.levelY + 3;
    buySLY = bullSweep.levelY - 5;
  } else {
    buyEntryY = currentY - analysis.avgRange * 0.5;
    buySLY = buyEntryY + analysis.avgRange * 0.6;
  }
  // TP1 : swing high le plus proche au-dessus
  const resAbove = smc.labeledSwings.filter(s => s.type === 'H' && s.y < buyEntryY).sort((a, b) => b.y - a.y)[0];
  buyTP1Y = resAbove ? resAbove.y : buyEntryY - analysis.avgRange * 2;
  // TP2 : equal highs ou swing high plus loin
  const eqHighs = smc.equalLevels.filter(g => g.type === 'H' && g.y < buyTP1Y).sort((a, b) => b.y - a.y)[0];
  buyTP2Y = eqHighs ? eqHighs.y : buyTP1Y - analysis.avgRange * 1.5;

  const buyConfluence = confluenceScore(true);
  const buyEntry = yToPrice(buyEntryY);
  const buySL = yToPrice(buySLY);
  const buyTP1 = yToPrice(buyTP1Y);
  const buyTP2 = yToPrice(buyTP2Y);
  const buyRR = (buyEntry !== null && buySL !== null && buyTP1 !== null && buyEntry > buySL)
    ? (buyTP1 - buyEntry) / (buyEntry - buySL) : null;
  const buySize = (buyEntry !== null && buySL !== null && buyEntry > buySL)
    ? (1 / (Math.abs(buyEntry-buySL)/buyEntry*100) * 100).toFixed(1) : null;

  // Setup VENTE
  const bearOB = smc.obs.bearish.filter(o => !o.mitigated && o.low < currentY).slice(-1)[0]
             || smc.obs.bearish.filter(o => o.low < currentY).slice(-1)[0]
             || smc.obs.bearish.slice(-1)[0];
  const bearFVG = smc.fvgs.filter(f => f.type === 'bearish' && f.yBot < currentY).slice(-1)[0];
  const bearSweep = smc.sweeps.filter(s => s.type === 'bearish').slice(-1)[0];

  let sellEntryY = null, sellSLY = null, sellTP1Y = null, sellTP2Y = null;
  if(bearOB){
    sellEntryY = bearOB.low;
    sellSLY = bearOB.high - 2;
  } else if(bearFVG){
    sellEntryY = bearFVG.yBot;
    sellSLY = bearFVG.yTop - 2;
  } else if(bearSweep){
    sellEntryY = bearSweep.levelY - 3;
    sellSLY = bearSweep.levelY + 5;
  } else {
    sellEntryY = currentY + analysis.avgRange * 0.5;
    sellSLY = sellEntryY - analysis.avgRange * 0.6;
  }
  const supBelow = smc.labeledSwings.filter(s => s.type === 'L' && s.y > sellEntryY).sort((a, b) => a.y - b.y)[0];
  sellTP1Y = supBelow ? supBelow.y : sellEntryY + analysis.avgRange * 2;
  const eqLows = smc.equalLevels.filter(g => g.type === 'L' && g.y > sellTP1Y).sort((a, b) => a.y - b.y)[0];
  sellTP2Y = eqLows ? eqLows.y : sellTP1Y + analysis.avgRange * 1.5;

  const sellConfluence = confluenceScore(false);
  const sellEntry = yToPrice(sellEntryY);
  const sellSL = yToPrice(sellSLY);
  const sellTP1 = yToPrice(sellTP1Y);
  const sellTP2 = yToPrice(sellTP2Y);
  const sellRR = (sellEntry !== null && sellSL !== null && sellTP1 !== null && sellSL > sellEntry)
    ? (sellEntry - sellTP1) / (sellSL - sellEntry) : null;
  const sellSize = (sellEntry !== null && sellSL !== null && sellSL > sellEntry)
    ? (1 / (Math.abs(sellSL-sellEntry)/sellEntry*100) * 100).toFixed(1) : null;

  // Favori
  const bias = smc.structure.bias;
  let favBuy = false, favSell = false;
  if(bias === 'up' && buyConfluence.score >= sellConfluence.score - 2) favBuy = true;
  else if(bias === 'down' && sellConfluence.score >= buyConfluence.score - 2) favSell = true;
  else if(buyConfluence.score > sellConfluence.score + 2) favBuy = true;
  else if(sellConfluence.score > buyConfluence.score + 2) favSell = true;

  return {
    currentPrice, calibrated, bias, profile:prof,
    long:{
      favored:favBuy, entry:buyEntry, sl:buySL, tp1:buyTP1, tp2:buyTP2, rr:buyRR, size:buySize,
      entryY:buyEntryY, slY:buySLY, tp1Y:buyTP1Y, tp2Y:buyTP2Y,
      confluence:buyConfluence
    },
    short:{
      favored:favSell, entry:sellEntry, sl:sellSL, tp1:sellTP1, tp2:sellTP2, rr:sellRR, size:sellSize,
      entryY:sellEntryY, slY:sellSLY, tp1Y:sellTP1Y, tp2Y:sellTP2Y,
      confluence:sellConfluence
    }
  };
}

function computeForecast(candles, analysis, smc){
  const last = candles[candles.length-1];
  const projX = last.x + (last.x - candles[0].x)*0.15;
  const projY = analysis.intercept + analysis.slope*projX;
  const projPrice = yToPrice(projY);
  const currentPrice = yToPrice(last.mid);

  const tb = analysis.trendDir === 'up' ? 1 : analysis.trendDir === 'down' ? -1 : 0;
  const rb = (analysis.rsi - 50)/50;
  const sb = smc.structure.bias === 'up' ? 1 : smc.structure.bias === 'down' ? -1 : 0;
  let pUp = Math.max(.12, Math.min(.82, .35 + .18*tb + .12*rb + .15*sb));
  let pDown = Math.max(.12, Math.min(.82, .35 - .18*tb - .12*rb - .15*sb));
  let pRange = Math.max(.12, 1 - pUp - pDown);
  const sum = pUp + pDown + pRange;
  return {projPrice, currentPrice, pUp:pUp/sum, pDown:pDown/sum, pRange:pRange/sum, projX, projY};
}

