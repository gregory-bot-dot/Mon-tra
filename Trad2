<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ChartVision SMC — Analyse TradingView</title>
<style>
  :root{
    --bg:#0b0e14;--panel:#131722;--panel2:#1a1f2c;--panel3:#222836;
    --line:#232c3d;--line2:#2f3a52;
    --txt:#d1d4dc;--muted:#8b94a8;--dim:#5d6577;
    --acc:#2962ff;--up:#26a69a;--down:#ef5350;--warn:#ff9800;--info:#ab47bc;
    --ob:#f9a825;--fvg:#26c6da;--liq:#ab47bc;--bos:#66bb6a;
  }
  *{box-sizing:border-box}html,body{height:100%}
  body{margin:0;background:var(--bg);color:var(--txt);font-family:-apple-system,BlinkMacSystemFont,"Trebuchet MS",Roboto,Arial,sans-serif;font-size:13.5px;-webkit-font-smoothing:antialiased;overflow:hidden}
  ::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-thumb{background:#2f3a52;border-radius:5px;border:2px solid var(--bg)}
  header{height:54px;display:flex;align-items:center;gap:10px;padding:0 14px;border-bottom:1px solid var(--line);background:#0e1219;position:relative;z-index:10;flex-wrap:wrap}
  .logo{width:28px;height:28px;border-radius:6px;flex-shrink:0;background:linear-gradient(135deg,#2962ff,#26a69a);position:relative}
  .logo::after{content:"";position:absolute;inset:5px;border-radius:2px;background:#0b0e14}
  header h1{font-size:14.5px;margin:0;font-weight:700;white-space:nowrap}
  header h1 span{color:var(--acc)}
  .hdr-fields{display:flex;gap:6px;align-items:center;margin-left:10px;flex-wrap:wrap}
  .hdr-fields select,.hdr-fields input{background:var(--panel2);border:1px solid var(--line);color:var(--txt);border-radius:5px;padding:5px 9px;font-size:12px;font-family:inherit;outline:none;height:27px}
  .hdr-fields input[type=text]{width:100px}
  .hdr-fields input:focus,.hdr-fields select:focus{border-color:var(--acc)}
  .hdr-actions{margin-left:auto;display:flex;gap:6px}
  .hdr-actions button{background:transparent;border:1px solid var(--line);color:var(--muted);padding:5px 11px;border-radius:5px;font-size:11.5px;cursor:pointer;font-family:inherit;height:27px}
  .hdr-actions button:hover{background:var(--panel2);color:var(--txt)}
  .hdr-actions button:disabled{opacity:.35;cursor:not-allowed}
  .app{display:grid;grid-template-columns:280px 1fr 480px;height:calc(100vh - 54px)}
  @media(max-width:1280px){.app{grid-template-columns:260px 1fr 420px}}
  @media(max-width:960px){.app{grid-template-columns:1fr;height:auto;overflow-y:auto}body{overflow:auto}header{position:sticky;top:0}}
  .panel{background:var(--panel);border-right:1px solid var(--line);overflow-y:auto;display:flex;flex-direction:column}
  .panel:last-child{border-right:none;border-left:1px solid var(--line)}
  .panel.center{border-right:1px solid var(--line);background:#070a10}
  .sect{padding:13px 14px;border-bottom:1px solid var(--line)}
  .sect:last-child{border-bottom:none}
  .sect h2{font-size:10.5px;text-transform:uppercase;letter-spacing:1.2px;color:var(--dim);margin:0 0 9px;font-weight:700;display:flex;align-items:center;gap:6px}
  .sect h2 .num{display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;background:var(--panel3);border-radius:3px;font-size:9.5px;color:var(--muted);font-weight:800}
  .drop{border:2px dashed var(--line2);border-radius:8px;padding:20px 12px;text-align:center;color:var(--muted);cursor:pointer;transition:.18s;font-size:12.5px;line-height:1.55}
  .drop:hover,.drop.hot{border-color:var(--acc);color:var(--txt);background:rgba(41,98,255,.06)}
  .drop svg{margin-bottom:6px;opacity:.6}
  .drop b{color:var(--txt)}
  input[type=file]{display:none}
  label.fld{display:block;font-size:10px;color:var(--dim);margin:9px 0 3px;text-transform:uppercase;letter-spacing:.7px;font-weight:600}
  input[type=text],input[type=number],select{width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--txt);border-radius:5px;padding:7px 10px;font-size:12.5px;font-family:inherit;outline:none}
  input:focus,select:focus{border-color:var(--acc)}
  input::placeholder{color:var(--dim)}
  .row{display:flex;gap:8px}.row>*{flex:1;min-width:0}
  button.btn{width:100%;border:1px solid var(--line);border-radius:6px;padding:9px 12px;font-weight:600;font-size:12.5px;cursor:pointer;font-family:inherit;background:var(--panel2);color:var(--txt);margin-top:7px;display:flex;align-items:center;justify-content:center;gap:6px}
  button.btn:hover{background:var(--panel3)}
  button.btn:disabled{opacity:.4;cursor:not-allowed}
  button.btn.primary{background:var(--acc);color:#fff;border-color:var(--acc)}
  button.btn.primary:hover{filter:brightness(1.1)}
  button.btn.ghost{background:transparent}
  button.btn.active{background:var(--up);color:#04121f;border-color:var(--up);font-weight:700}
  .note{font-size:11px;color:var(--dim);line-height:1.5;margin-top:8px}
  .warnbox{background:rgba(255,152,0,.07);border:1px solid rgba(255,152,0,.25);color:#ffb74d;padding:8px 10px;border-radius:6px;font-size:11px;line-height:1.5;margin-top:10px}
  .okbox{background:rgba(38,166,154,.08);border:1px solid rgba(38,166,154,.28);color:#4dd0c4;padding:8px 10px;border-radius:6px;font-size:11px;line-height:1.5;margin-top:8px}
  .calib-steps{background:rgba(41,98,255,.06);border:1px solid rgba(41,98,255,.25);color:#7ea6ff;padding:9px 11px;border-radius:6px;font-size:11.5px;line-height:1.5;margin-top:8px}
  .chart-wrap{flex:1;display:flex;align-items:center;justify-content:center;overflow:auto;padding:14px;position:relative}
  .canvas-inner{position:relative;line-height:0;display:none}
  canvas{display:block;max-width:100%;height:auto}
  #overlay{position:absolute;inset:0;width:100%;height:100%;cursor:crosshair}
  .empty-chart{color:var(--dim);text-align:center;padding:40px 20px;font-size:13px;line-height:1.6}
  .chart-toolbar{padding:9px 14px;border-top:1px solid var(--line);background:var(--panel);display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:11px}
  .chart-toolbar label{color:var(--muted);display:flex;align-items:center;gap:5px;white-space:nowrap;cursor:pointer;user-select:none}
  .chart-toolbar input[type=range]{width:90px;accent-color:var(--acc)}
  .chart-toolbar .sep{width:1px;height:16px;background:var(--line)}
  .chart-toolbar .status{margin-left:auto;color:var(--dim);font-weight:600}
  .tabs{display:flex;border-bottom:1px solid var(--line);background:var(--panel);position:sticky;top:0;z-index:5}
  .tab{flex:1;padding:11px 4px;background:transparent;border:none;color:var(--muted);font-size:10.5px;font-weight:700;cursor:pointer;font-family:inherit;border-bottom:2px solid transparent;margin-bottom:-1px;text-transform:uppercase;letter-spacing:.4px}
  .tab:hover{color:var(--txt)}
  .tab.active{color:var(--acc);border-bottom-color:var(--acc)}
  .results{flex:1;overflow-y:auto;padding:14px 15px;font-size:13px;line-height:1.6}
  .results h2{font-size:12.5px;border-bottom:1px solid var(--line);padding-bottom:6px;margin:16px 0 8px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted)}
  .results h3{font-size:12.5px;color:var(--acc);margin:13px 0 6px}
  .results p{margin:7px 0}
  .results ul,.results ol{padding-left:19px;margin:5px 0}
  .results li{margin:3px 0}
  .results code{background:var(--panel3);padding:1px 6px;border-radius:3px;font-size:11px;font-family:ui-monospace,monospace;color:#63a4ff}
  .results strong{color:#fff}
  .results hr{border:none;border-top:1px solid var(--line);margin:14px 0}
  .kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:12px}
  .kpi{background:var(--panel2);border:1px solid var(--line);border-radius:7px;padding:9px 11px;position:relative;overflow:hidden}
  .kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--dim)}
  .kpi.up::before{background:var(--up)}.kpi.down::before{background:var(--down)}.kpi.neu::before{background:var(--warn)}.kpi.info::before{background:var(--acc)}
  .kpi small{display:block;color:var(--dim);font-size:9.5px;text-transform:uppercase;letter-spacing:.6px;font-weight:600;margin-bottom:2px}
  .kpi b{display:block;font-size:14px;font-weight:700;line-height:1.2}
  .kpi .sub{font-size:10px;color:var(--dim);margin-top:1px;font-weight:400}
  .up-text{color:var(--up)}.down-text{color:var(--down)}.neu-text{color:var(--warn)}
  .setup{border-radius:8px;padding:13px;margin-bottom:10px;border:1px solid var(--line);background:var(--panel2);position:relative;overflow:hidden}
  .setup.buy{border-color:rgba(38,166,154,.4);background:linear-gradient(180deg,rgba(38,166,154,.07),var(--panel2))}
  .setup.sell{border-color:rgba(239,83,80,.4);background:linear-gradient(180deg,rgba(239,83,80,.07),var(--panel2))}
  .setup.wait{border-color:rgba(255,152,0,.4);background:linear-gradient(180deg,rgba(255,152,0,.07),var(--panel2))}
  .setup-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding-bottom:9px;border-bottom:1px solid var(--line);gap:8px;flex-wrap:wrap}
  .setup-head h3{margin:0;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:7px}
  .setup.buy .setup-head h3{color:var(--up)}.setup.sell .setup-head h3{color:var(--down)}.setup.wait .setup-head h3{color:var(--warn)}
  .setup-head .conf{font-size:10px;color:var(--muted);padding:3px 8px;background:var(--panel3);border-radius:20px;font-weight:600}
  .setup-head .conf.good{background:rgba(38,166,154,.15);color:var(--up)}
  .trade-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:9px}
  .trade-cell{background:rgba(0,0,0,.22);border-radius:5px;padding:7px 9px;border:1px solid var(--line)}
  .trade-cell small{display:block;font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:.6px;margin-bottom:2px}
  .trade-cell b{font-size:13px;font-family:ui-monospace,monospace;font-weight:700;display:block}
  .trade-cell.entry b{color:var(--acc)}.trade-cell.sl b{color:var(--down)}.trade-cell.tp b{color:var(--up)}.trade-cell.rr b{color:var(--warn)}
  .rr-bar{height:4px;background:var(--panel3);border-radius:2px;overflow:hidden;margin:5px 0 3px;display:flex}
  .rr-bar .risk{background:var(--down)}.rr-bar .reward{background:var(--up)}
  .trade-reason{font-size:11px;color:var(--muted);line-height:1.5;padding:7px 9px;background:rgba(0,0,0,.18);border-radius:5px;border-left:2px solid var(--acc);margin-top:8px}
  .trade-reason strong{color:var(--txt)}
  .confluence{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
  .tag{font-size:10px;padding:2px 7px;border-radius:10px;background:var(--panel3);border:1px solid var(--line2);color:var(--muted);font-weight:600}
  .tag.on{background:rgba(38,166,154,.15);border-color:rgba(38,166,154,.35);color:var(--up)}
  .scenario{background:var(--panel2);border:1px solid var(--line);border-radius:7px;padding:10px 11px;margin-bottom:7px;display:flex;gap:10px;align-items:flex-start}
  .scenario .prob{flex-shrink:0;width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;background:conic-gradient(var(--acc) var(--p),var(--panel3) 0);color:var(--txt);position:relative}
  .scenario .prob::before{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--panel2)}
  .scenario .prob span{position:relative;z-index:1}
  .scenario.up .prob{background:conic-gradient(var(--up) var(--p),var(--panel3) 0)}
  .scenario.down .prob{background:conic-gradient(var(--down) var(--p),var(--panel3) 0)}
  .scenario.neu .prob{background:conic-gradient(var(--warn) var(--p),var(--panel3) 0)}
  .scenario .body{flex:1;min-width:0}
  .scenario .body h4{margin:0 0 3px;font-size:12px;font-weight:700}
  .scenario.up .body h4{color:var(--up)}.scenario.down .body h4{color:var(--down)}.scenario.neu .body h4{color:var(--warn)}
  .scenario .body p{margin:0;font-size:11px;color:var(--muted);line-height:1.45}
  .smc-block{background:var(--panel2);border:1px solid var(--line);border-radius:7px;padding:9px 11px;margin-bottom:6px;display:flex;gap:10px;align-items:flex-start}
  .smc-block .icon{width:22px;height:22px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0}
  .smc-block.ob-bull .icon{background:rgba(38,166,154,.15);color:var(--up)}
  .smc-block.ob-bear .icon{background:rgba(239,83,80,.15);color:var(--down)}
  .smc-block.fvg-bull .icon{background:rgba(38,198,218,.15);color:var(--fvg)}
  .smc-block.fvg-bear .icon{background:rgba(38,198,218,.15);color:var(--fvg)}
  .smc-block.liq .icon{background:rgba(171,71,188,.15);color:var(--liq)}
  .smc-block.bos .icon{background:rgba(102,187,106,.15);color:var(--bos)}
  .smc-block .content{flex:1;min-width:0;font-size:11.5px;line-height:1.5}
  .smc-block .content strong{display:block;color:var(--txt);font-size:12px;margin-bottom:2px}
  .smc-block .content .meta{color:var(--dim);font-size:10.5px}
  .smc-block .zone{font-family:ui-monospace,monospace;color:var(--acc);font-weight:700}
  .level-row{display:flex;align-items:center;gap:9px;padding:6px 9px;background:var(--panel2);border-radius:5px;margin-bottom:4px;border:1px solid var(--line);font-size:12px}
  .level-row .price{font-family:ui-monospace,monospace;font-weight:700;min-width:80px;font-size:12.5px}
  .level-row .type{font-size:10.5px;color:var(--dim);flex:1}
  .level-row .strength{width:46px;height:3px;background:var(--panel3);border-radius:2px;overflow:hidden}
  .level-row .strength div{height:100%;background:linear-gradient(90deg,var(--warn),var(--down))}
  .level-row.resistance .price{color:var(--down)}
  .level-row.support .price{color:var(--up)}
  .spin{display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,.2);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:6px}
  @keyframes spin{to{transform:rotate(360deg)}}
  .progress{height:3px;background:var(--panel3);border-radius:2px;overflow:hidden;margin-top:7px;display:none}
  .progress.on{display:block}
  .progress div{height:100%;background:linear-gradient(90deg,var(--acc),var(--up));width:0;transition:width .2s;border-radius:2px}
  .modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;z-index:100;padding:20px}
  .modal-backdrop.on{display:flex}
  .modal{background:var(--panel);border:1px solid var(--line2);border-radius:10px;max-width:680px;width:100%;max-height:80vh;overflow-y:auto;padding:22px}
  .modal h2{margin:0 0 12px;font-size:16px}
  .modal h3{font-size:13px;color:var(--acc);margin:14px 0 5px}
  .modal p,.modal li{font-size:12.5px;line-height:1.6;color:var(--muted)}
  .modal ul{padding-left:19px}
  .modal .close{float:right;background:transparent;border:none;color:var(--muted);font-size:22px;cursor:pointer;padding:0;line-height:1}
  .modal .close:hover{color:var(--txt)}
  .hidden{display:none !important}
</style>
</head>
<body>

<header>
  <div class="logo"></div>
  <h1>Chart<span>Vision</span> SMC</h1>
  <div class="hdr-fields">
    <select id="assetType" title="Type d'actif">
      <option value="auto">🔍 Auto</option>
      <option value="crypto">₿ Crypto</option>
      <option value="forex">💱 Forex</option>
      <option value="stocks">📈 Actions</option>
      <option value="indices">📊 Indices</option>
      <option value="commodities">🛢 Mat. prem.</option>
    </select>
    <input type="text" id="symbol" placeholder="Symbole" maxlength="20">
    <input type="text" id="timeframe" placeholder="TF" style="width:55px" maxlength="4">
  </div>
  <div class="hdr-actions">
    <button id="btnExport" disabled>⬇ Rapport</button>
    <button id="btnHelp">? Aide</button>
  </div>
</header>

<div class="app">

  <aside class="panel">
    <div class="sect">
      <h2><span class="num">1</span>Screenshot TradingView</h2>
      <div class="drop" id="drop">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>
        </svg>
        <div><b>Cliquez</b> ou <b>glissez</b></div>
        <div style="font-size:10.5px;margin-top:3px;color:var(--dim)">ou Ctrl+V</div>
      </div>
      <input type="file" id="file" accept="image/*">
      <button class="btn ghost" id="btnClear" disabled>Effacer</button>
    </div>

    <div class="sect">
      <h2><span class="num">2</span>Calibration prix</h2>
      <button class="btn primary" id="btnClick" disabled>🎯 Calibrer au clic</button>
      <button class="btn ghost" id="btnOCR" disabled>🔍 Lire l'axe (OCR)</button>
      <div class="progress" id="ocrProgress"><div></div></div>
      <div class="calib-steps hidden" id="calibSteps">
        <strong>Mode clic actif</strong><br>
        1. Cliquez sur un label de prix de l'axe<br>
        2. Saisissez la valeur<br>
        3. Recommencez sur un second label<br>
        <span id="calibState">Point 1/2 en attente…</span>
      </div>
      <details style="margin-top:9px">
        <summary style="cursor:pointer;color:var(--muted);font-size:11px;padding:3px 0">Saisie manuelle</summary>
        <div class="row" style="margin-top:7px">
          <div><label class="fld">Prix haut</label><input type="number" id="pTop" step="any" placeholder=""></div>
          <div><label class="fld">Prix bas</label><input type="number" id="pBot" step="any" placeholder=""></div>
        </div>
      </details>
      <div class="note" id="calStatus">Sans calibration : % de hauteur. Pour des prix exacts, utilisez <strong>Calibrer au clic</strong>.</div>
    </div>

    <div class="sect">
      <h2><span class="num">3</span>Options SMC</h2>
      <label style="display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted);cursor:pointer;padding:4px 0">
        <input type="checkbox" id="optOB" checked> Order Blocks
      </label>
      <label style="display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted);cursor:pointer;padding:4px 0">
        <input type="checkbox" id="optFVG" checked> Fair Value Gaps
      </label>
      <label style="display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted);cursor:pointer;padding:4px 0">
        <input type="checkbox" id="optLiq" checked> Liquidité / sweeps
      </label>
      <label style="display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted);cursor:pointer;padding:4px 0">
        <input type="checkbox" id="optBOS" checked> BOS / CHoCH
      </label>
      <label style="display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted);cursor:pointer;padding:4px 0">
        <input type="checkbox" id="optPD" checked> Premium / Discount
      </label>
    </div>

    <details class="sect" style="padding:13px 14px">
      <summary style="cursor:pointer;color:var(--muted);font-size:11px;font-weight:600">Analyse IA (optionnel)</summary>
      <div style="margin-top:9px">
        <label class="fld">Fournisseur</label>
        <select id="provider">
          <option value="openai">OpenAI</option>
          <option value="anthropic">Anthropic</option>
          <option value="gemini">Google Gemini</option>
        </select>
        <label class="fld">Modèle</label>
        <input type="text" id="model" value="gpt-4o">
        <label class="fld">Clé API</label>
        <input type="password" id="apiKey" placeholder="facultatif">
        <button class="btn primary" id="btnAI" disabled>✨ Analyser avec l'IA</button>
        <button class="btn ghost" id="btnPrompt" disabled>📋 Copier le prompt</button>
      </div>
    </details>
  </aside>

  <main class="panel center">
    <div class="chart-wrap" id="chartWrap">
      <div class="empty-chart" id="emptyChart">
        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M3 3v18h18"/><path d="M7 15l3-3 3 3 5-6"/>
        </svg>
        <div>Chargez un screenshot TradingView</div>
        <div style="font-size:11px;margin-top:3px;opacity:.7">Analyse SMC : Order Blocks · FVG · Liquidité · BOS/CHoCH</div>
      </div>
      <div class="canvas-inner" id="canvasInner">
        <canvas id="cv"></canvas>
        <canvas id="overlay"></canvas>
      </div>
    </div>
    <div class="chart-toolbar">
      <label>Zoom <input type="range" id="zoom" min="100" max="400" value="100"></label>
      <span id="zoomVal" style="color:var(--dim)">100%</span>
      <div class="sep"></div>
      <label><input type="checkbox" id="showOB" checked> OB</label>
      <label><input type="checkbox" id="showFVG" checked> FVG</label>
      <label><input type="checkbox" id="showLiq" checked> Liq</label>
      <label><input type="checkbox" id="showBOS" checked> BOS</label>
