/* ============ OVERLAY ============ */
function drawOverlay(){
  const o = S.octx, W = S.ov.width, H = S.ov.height;
  o.clearRect(0, 0, W, H);
  if(!S.analysis || !S.smc) return;
  const lw = Math.max(1, W/1400);

  // Order Blocks
  if($('showOB').checked){
    for(const ob of S.smc.obs.bullish){
      o.fillStyle = ob.mitigated ? 'rgba(38,166,154,.06)' : 'rgba(38,166,154,.12)';
      o.fillRect(0, ob.high, W, ob.low - ob.high);
      o.strokeStyle = 'rgba(38,166,154,.6)';
      o.lineWidth = lw;
      o.setLineDash(ob.mitigated ? [3, 3] : []);
      o.beginPath(); o.moveTo(0, ob.high); o.lineTo(W, ob.high); o.stroke();
      o.beginPath(); o.moveTo(0, ob.low); o.lineTo(W, ob.low); o.stroke();
      o.setLineDash([]);
      o.font = `bold ${Math.max(9, W/120)}px -apple-system, sans-serif`;
      o.fillStyle = '#26a69a';
      o.fillText('OB+', 6, ob.high - 4);
    }
    for(const ob of S.smc.obs.bearish){
      o.fillStyle = ob.mitigated ? 'rgba(239,83,80,.06)' : 'rgba(239,83,80,.12)';
      o.fillRect(0, ob.high, W, ob.low - ob.high);
      o.strokeStyle = 'rgba(239,83,80,.6)';
      o.lineWidth = lw;
      o.setLineDash(ob.mitigated ? [3, 3] : []);
      o.beginPath(); o.moveTo(0, ob.high); o.lineTo(W, ob.high); o.stroke();
      o.beginPath(); o.moveTo(0, ob.low); o.lineTo(W, ob.low); o.stroke();
      o.setLineDash([]);
      o.font = `bold ${Math.max(9, W/120)}px -apple-system, sans-serif`;
      o.fillStyle = '#ef5350';
      o.fillText('OB−', 6, ob.high - 4);
    }
  }

  // FVG
  if($('showFVG').checked){
    for(const f of S.smc.fvgs){
      o.fillStyle = 'rgba(38,198,218,.1)';
      o.fillRect(0, Math.min(f.yTop, f.yBot), W, Math.abs(f.yBot - f.yTop));
      o.strokeStyle = 'rgba(38,198,218,.5)';
      o.lineWidth = lw;
      o.setLineDash([4, 3]);
      o.beginPath(); o.moveTo(0, f.yTop); o.lineTo(W, f.yTop); o.stroke();
      o.beginPath(); o.moveTo(0, f.yBot); o.lineTo(W, f.yBot); o.stroke();
      o.setLineDash([]);
      o.font = `bold ${Math.max(9, W/120)}px -apple-system, sans-serif`;
      o.fillStyle = '#26c6da';
      o.fillText('FVG ' + (f.type === 'bullish' ? '+' : '−'), 6, Math.min(f.yTop, f.yBot) - 4);
    }
  }

  // Sweeps et equal levels
  if($('showLiq').checked){
    for(const s of S.smc.sweeps.slice(-3)){
      o.strokeStyle = 'rgba(171,71,188,.75)';
      o.lineWidth = lw*1.5;
      o.setLineDash([6, 3]);
      o.beginPath(); o.moveTo(0, s.levelY); o.lineTo(W, s.levelY); o.stroke();
      o.setLineDash([]);
      o.font = `bold ${Math.max(9, W/120)}px -apple-system, sans-serif`;
      o.fillStyle = '#ab47bc';
      o.fillText(s.label, 6, s.levelY - 4);
    }
    for(const e of S.smc.equalLevels){
      o.strokeStyle = 'rgba(171,71,188,.45)';
      o.lineWidth = lw;
      o.setLineDash([2, 4]);
      o.beginPath(); o.moveTo(0, e.y); o.lineTo(W, e.y); o.stroke();
      o.setLineDash([]);
      o.font = `${Math.max(9, W/120)}px -apple-system, sans-serif`;
      o.fillStyle = 'rgba(171,71,188,.85)';
      o.fillText((e.type === 'H' ? 'EQH' : 'EQL'), 6, e.y - 3);
    }
  }

  // BOS / CHoCH
  if($('showBOS').checked){
    for(const ev of S.smc.bosCHoCH.slice(-4)){
      o.strokeStyle = ev.type === 'CHoCH' ? 'rgba(255,152,0,.8)' : 'rgba(102,187,106,.7)';
      o.lineWidth = lw*1.3;
      o.setLineDash(ev.type === 'CHoCH' ? [4, 3] : []);
      o.beginPath(); o.moveTo(0, ev.levelY); o.lineTo(W, ev.levelY); o.stroke();
      o.setLineDash([]);
      o.font = `bold ${Math.max(9, W/120)}px -apple-system, sans-serif`;
      o.fillStyle = ev.type === 'CHoCH' ? '#ff9800' : '#66bb6a';
      o.fillText(ev.type, 6, ev.levelY - 3);
    }
  }

  // Setup entrée
  if($('showEntry').checked && S.setups){
    const s = S.setups.long.favored ? S.setups.long : (S.setups.short.favored ? S.setups.short : null);
    if(s){
      const drawLine = (y, color, label, dashed) => {
        o.strokeStyle = color;
        o.lineWidth = lw*1.4;
        o.setLineDash(dashed ? [6, 4] : []);
        o.beginPath(); o.moveTo(0, y); o.lineTo(W, y); o.stroke();
        o.setLineDash([]);
        o.font = `bold ${Math.max(10, W/95)}px -apple-system, sans-serif`;
        const tw = o.measureText(label).width;
        o.fillStyle = color;
        o.fillRect(W - tw - 16, y - 16, tw + 12, 15);
        o.fillStyle = '#04121f';
        o.fillText(label, W - tw - 10, y - 4);
      };
      [['entryY', '#2962ff', 'E'], ['slY', '#ef5350', 'SL'], ['tp1Y', '#26a69a', 'TP1']].forEach(([k, c, lbl]) => {
        const y = s[k];
        if(y === null || y === undefined) return;
        const price = k === 'entryY' ? s.entry : k === 'slY' ? s.sl : s.tp1;
        drawLine(y, c, `${lbl} ${price !== null ? fmtPrice(price) : priceOrPct(y)}`, k !== 'entryY');
      });
    }
  }

  // Calibration mode : crosshair + points
  if(S.calibMode){
    if(S.mouse){
      o.strokeStyle = 'rgba(41,98,255,.7)';
      o.lineWidth = 1;
      o.beginPath(); o.moveTo(S.mouse.x, 0); o.lineTo(S.mouse.x, H); o.stroke();
      o.beginPath(); o.moveTo(0, S.mouse.y); o.lineTo(W, S.mouse.y); o.stroke();
      o.font = `bold ${Math.max(11, W/85)}px -apple-system, sans-serif`;
      o.fillStyle = 'rgba(41,98,255,.95)';
      o.fillRect(W - 130, S.mouse.y - 18, 120, 16);
      o.fillStyle = '#fff';
      o.fillText('Cliquez sur un label', W - 124, S.mouse.y - 6);
    }
    for(const p of S.calibPoints){
      o.strokeStyle = '#ff9800';
      o.lineWidth = 2;
      o.beginPath(); o.arc(p.y, p.y, 4, 0, Math.PI*2); o.stroke();
      o.fillStyle = 'rgba(255,152,0,.9)';
      o.fillRect(4, p.y - 16, 90, 15);
      o.fillStyle = '#000';
      o.font = `bold ${Math.max(10, W/100)}px -apple-system`;
      o.fillText('P' + (S.calibPoints.indexOf(p)+1) + ' : ' + p.price, 8, p.y - 4);
    }
  }
}

/* ============ CALIBRATION AU CLIC ============ */
function startClickCalibration(){
  if(!S.loaded) return;
  S.calibMode = true;
  S.calibPoints = [];
  $('calibSteps').classList.remove('hidden');
  $('calibState').textContent = 'Point 1/2 en attente — cliquez sur un label de l\'axe.';
  $('btnClick').classList.add('active');
  $('btnClick').textContent = '🎯 Annuler';
  drawOverlay();
}

function cancelClickCalibration(){
  S.calibMode = false;
  S.calibPoints = [];
  $('calibSteps').classList.add('hidden');
  $('btnClick').classList.remove('active');
  $('btnClick').textContent = '🎯 Calibrer au clic';
  drawOverlay();
}

function onCalibClick(y){
  if(!S.calibMode) return;
  const valStr = prompt(
    S.calibPoints.length === 0
      ? 'Prix du premier label (ex. 65000) :'
      : 'Prix du second label (ex. 62000) :'
  );
  if(valStr === null){ return; }
  const price = parseFloat(valStr.replace(',', '.').replace(/\s/g, ''));
  if(isNaN(price)){ alert('Valeur invalide.'); return; }
  S.calibPoints.push({ y, price });
  if(S.calibPoints.length === 1){
    $('calibState').textContent = 'Point 2/2 en attente — cliquez sur un autre label.';
    drawOverlay();
  } else {
    const [p1, p2] = S.calibPoints;
    S.priceCal = {
      mode: 'click',
      p1: { y: p1.y, price: p1.price },
      p2: { y: p2.y, price: p2.price },
      source: 'click',
      dec: inferDecimals(Math.max(Math.abs(p1.price), Math.abs(p2.price)))
    };
    $('pTop').value = p1.price.toFixed(S.priceCal.dec);
    $('pBot').value = p2.price.toFixed(S.priceCal.dec);
    $('calStatus').innerHTML = `<span style="color:var(--up)">✓ Calibré au clic : ${p1.price} et ${p2.price}</span>`;
    cancelClickCalibration();
    runAnalysis();
  }
}

/* ============ OCR (fallback) ============ */
async function loadTesseract(){
  if(window.Tesseract) return window.Tesseract;
  return new Promise((res, rej) => {
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';
    s.onload = () => res(window.Tesseract);
    s.onerror = rej;
    document.head.appendChild(s);
  });
}

async function calibrateOCR(){
  const btn = $('btnOCR');
  btn.disabled = true;
  btn.innerHTML = '<span class="spin"></span>OCR…';
  $('ocrProgress').classList.add('on');
  try{
    const T = await loadTesseract();
    const W = S.cv.width, H = S.cv.height;
    const L = S.layout;
    const stripW = Math.max(70, Math.round(W * 0.09));

    const mkStrip = (x0) => {
      const c = document.createElement('canvas');
      c.width = stripW*3; c.height = H*3;
      const ctx = c.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(S.cv, x0, 0, stripW, H, 0, 0, stripW*3, H*3);
      return c;
    };

    const rightCrop = mkStrip(W - stripW);
    const leftCrop = mkStrip(0);

    const progress = p => { $('ocrProgress').firstElementChild.style.width = Math.round(p*100) + '%'; };

    const rightRes = await T.recognize(rightCrop, 'eng', {logger: m => { if(m.status === 'recognizing text') progress(m.progress*0.5); }});
    const leftRes = await T.recognize(leftCrop, 'eng', {logger: m => { if(m.status === 'recognizing text') progress(0.5 + m.progress*0.5); }});

    const parseNums = (data, yScale) => {
      const nums = [];
      for(const w of (data.words || [])){
        if(w.confidence < 45) continue;
        const txt = w.text.replace(/,/g, '.').replace(/[^\d.\-]/g, '');
        const v = parseFloat(txt);
        if(isNaN(v) || Math.abs(v) < 1e-4) continue;
        const yc = (w.bbox.y0 + w.bbox.y1) / 2 / yScale;
        nums.push({ y: yc, price: v });
      }
      return nums;
    };

    const rightNums = parseNums(rightRes.data, 3);
    const leftNums = parseNums(leftRes.data, 3);

    let nums = rightNums.length >= leftNums.length ? rightNums : leftNums;
    const axisSide = rightNums.length >= leftNums.length ? 'droite' : 'gauche';

    if(nums.length < 3){
      $('calStatus').innerHTML = '<span style="color:var(--warn)">⚠ OCR insuffisant. Utilisez « Calibrer au clic ».</span>';
      return;
    }

    // Tri et nettoyage : on garde les nombres qui forment une séquence monotone en y
    nums.sort((a, b) => a.y - b.y);
    // Détection des inversions (le prix doit être monotone)
    const clean = [nums[0]];
    for(let i = 1; i < nums.length; i++){
      const prev = clean[clean.length-1];
      const cur = nums[i];
      if(cur.y - prev.y < 5) continue;
      if(Math.sign(cur.price - prev.price) !== Math.sign(clean.length === 1 ? (cur.price - prev.price) : (clean[clean.length-1].price - clean[clean.length-2].price)) && clean.length >= 2) continue;
      clean.push(cur);
    }

    if(clean.length < 2){
      $('calStatus').innerHTML = '<span style="color:var(--warn)">⚠ OCR non monotone. Utilisez « Calibrer au clic ».</span>';
      return;
    }

    // Régression linéaire sur les points propres
    const n = clean.length;
    let sy = 0, sp = 0, syy = 0, syp = 0;
    for(const p of clean){ sy += p.y; sp += p.price; syy += p.y*p.y; syp += p.y*p.price; }
    const a = (n*syp - sy*sp) / (n*syy - sy*sy || 1);
    const b = (sp - a*sy) / n;

    // Points p1 / p2 aux extrémités
    const y1 = clean[0].y, y2 = clean[clean.length-1].y;
    const p1p = a*y1 + b, p2p = a*y2 + b;
    if(Math.abs(p2p - p1p) < 1e-6){
      $('calStatus').innerHTML = '<span style="color:var(--warn)">⚠ OCR plat. Utilisez « Calibrer au clic ».</span>';
      return;
    }

    S.priceCal = {
      mode: 'ocr',
      p1: { y: y1, price: p1p },
      p2: { y: y2, price: p2p },
      source: 'ocr',
      dec: inferDecimals(Math.max(Math.abs(p1p), Math.abs(p2p)))
    };
    $('pTop').value = p1p.toFixed(S.priceCal.dec);
    $('pBot').value = p2p.toFixed(S.priceCal.dec);
    $('calStatus').innerHTML = `<span style="color:var(--up)">✓ OCR axe ${axisSide} : ${clean.length} points</span>`;

    runAnalysis();
  }catch(err){
    console.error(err);
    $('calStatus').innerHTML = '<span style="color:var(--warn)">⚠ OCR indisponible. Utilisez « Calibrer au clic ».</span>';
  }finally{
    btn.disabled = false;
    btn.innerHTML = "🔍 Lire l'axe (OCR)";
    $('ocrProgress').classList.remove('on');
    $('ocrProgress').firstElementChild.style.width = '0';
  }
}

/* ============ MANUEL ============ */
function updateManualCal(){
  const pT = parseFloat($('pTop').value);
  const pB = parseFloat($('pBot').value);
  if(isNaN(pT) || isNaN(pB) || !S.analysis) return;
  S.priceCal = {
    mode: 'manual',
    p1: { y: S.analysis.minY, price: pT },
    p2: { y: S.analysis.maxY, price: pB },
    source: 'manual',
    dec: inferDecimals(Math.max(Math.abs(pT), Math.abs(pB)))
  };
  $('calStatus').innerHTML = '<span style="color:var(--up)">✓ Calibré manuellement</span>';
  runAnalysis();
}

